# Ignore node_modules (if applicable)
node_modules/

# Ignore macOS system files
.DS_Store

# Ignore build artifacts (if applicable)
/build
/dist

# Ignore log files (if applicable)
*.log

# Ignore env files (if applicable)
.env

# Ignore Android build artifacts (for example, app/build)
app/build/

# Ignore Google Services configuration
app/google-services.json

# Ignore Gradle caches (if applicable)
.gradle/

# Ignore local.properties (if applicable)
local.properties

# Ignore IDE generated files (for example, .idea, *.iml)
.idea/
*.iml

# Ignore generated caches (for example, .DS_Store, Thumbs.db, and generated caches)
Thumbs.db
.cache/

# Ignore generated (or unnecessary) files (for example, generated caches, logs, and generated dex archives)
**/build/
**/tmp/
**/generated/
**/out/
**/intermediates/ 